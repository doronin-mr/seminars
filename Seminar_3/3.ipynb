   "source": [
    "def F(a, b, k1=0, k2=1, k3=1, k4=0):\n",
    "    d = (a//b)\n",
    "    if a % b == 0:\n",
    "        return k1, k2, b\n",
    "    return F(b, a % b, -d*k1 + k3, -d*k2 + k4, k1, k2)\n",
    "\n",
    "print(*F(*map(int, input().split())))"
   ]
