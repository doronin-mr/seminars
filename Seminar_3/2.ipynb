   "source": [
    "def F(N, a):\n",
    "    for i in range(a[-1] if len(a)>0 else 2, int(N**1/2) + 1):\n",
    "        if N % i == 0:\n",
    "            a.append(i)\n",
    "            F(N//i, a)\n",
    "            return a\n",
    "    a.append(N)\n",
    "    return a\n",
    "\n",
    "print(F(int(input()), []))"
   ]
  },
