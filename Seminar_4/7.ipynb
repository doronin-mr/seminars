   "id": "4d143b19-a729-4eb2-bd74-c131ce7824a5",
   "metadata": {},
   "outputs": [],
   "source": [
    "with open(\"Divaricated.txt\", encoding=\"utf-8\") as t:\n",
    "    text = t.read()\n",
    "a = re.split(\"[^\\w']+\", text)\n",
    "count = {}\n",
    "for i in a:\n",
    "    count[i.lower()] = count.get(i.lower(), 0) + 1"
   ]
  },
