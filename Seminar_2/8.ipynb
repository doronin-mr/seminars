    "a = list(map(int, input().split()))\n",
    "for i in a:\n",
    "    n = 0\n",
    "    for j in a:\n",
    "        if j < i:\n",
    "            n += 1\n",
    "    if n == len(a)//2:\n",
    "        print(i)\n",
    "        break"
