   "source": [
    "a = list(map(int, input().split()))\n",
    "n = a[0]\n",
    "cards = a[1:]\n",
    "res = 0\n",
    "for i in cards:\n",
    "    res ^= i\n",
    "for i in range(1, n+1):\n",
    "    res ^= i\n",
    "print(res)"
   ]
  }
