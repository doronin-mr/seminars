    "n, s = input().split()\n",
    "n = int(n)\n",
    "res = \"\"\n",
    "step = len(s)//n\n",
    "for i in range(0, len(s), step):\n",
    "    res += s[i:i+step][::-1]\n",
    "print(res)"
