    "N, b, c = input().split()\n",
    "N_10 = int(N,int(b))\n",
    "res = \"\"\n",
    "c = int(c)\n",
    "while N_10>0:\n",
    "    res = str(N_10 % c) + res\n",
    "    N_10 //= c\n",
    "print(res)"
